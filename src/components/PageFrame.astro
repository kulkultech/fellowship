---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/PageFrame.astro';
import { SHOW_DRAFT_BANNER } from '../config';
---

{SHOW_DRAFT_BANNER && (
	<>
		<style is:global>
			:root {
				--sl-banner-height: 2.75rem;
			}
		</style>
		<div class="draft-announcement-banner">
			<div class="banner-content">
				⚠️ This has not been officially announced. All of the information here is not valid until this banner is removed by the owner of the page.
			</div>
		</div>
	</>
)}

<Default {...Astro.props}>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
</Default>

<style>
	.draft-announcement-banner {
		background: linear-gradient(90deg, #ff4e50, #f9d423);
		color: #1a1a1a;
		height: 2.75rem;
		box-sizing: border-box;
		text-align: center;
		font-weight: 700;
		font-size: 0.85rem;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 101;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		letter-spacing: 0.02em;
		display: flex;
		justify-content: center;
		align-items: center;
		border-bottom: 1px solid rgba(0, 0, 0, 0.1);
	}
	.banner-content {
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 1rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	@media (max-width: 50rem) {
		:root {
			--sl-banner-height: 3.5rem !important;
		}
		.draft-announcement-banner {
			height: 3.5rem;
			font-size: 0.75rem;
		}
		.banner-content {
			white-space: normal;
		}
	}
</style>
